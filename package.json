{
	"name": "streamdeck-dark-mode",
	"version": "1.1.0",
	"description": "Stream Deck plugin to toggle dark mode on macOS and Windows.",
	"author": "Max Rodrigo <contact@maxrodrigo.com> (https://www.maxrodrigo.com)",
	"license": "MIT",
	"repository": "github:maxrodrigo/streamdeck-dark-mode",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.maxrodrigo.dark-mode\"",
		"pack": "npm run build && streamdeck pack com.maxrodrigo.dark-mode.sdPlugin",
		"test": "node --test"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.2"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.2",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.19.2",
		"rollup": "^4.64.6",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	}
}
